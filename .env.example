POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
PAYMENT_API_KEY=local-development-api-key-change-me-123456
PAYMENT_WEBHOOK_ALLOWED_ORIGINS='["http://callback:8080"]'
POSTGRES_PORT=55432
RABBIT_PORT=5673
RABBIT_MANAGEMENT_PORT=15673
API_PORT=8000
CALLBACK_PORT=8080

# Templates expand the variables above. URI-encode credentials in complete URLs
# manually if a password contains URI-reserved characters.
PAYMENT_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
PAYMENT_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
TEST_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/payments_test
TEST_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@127.0.0.1:${RABBIT_PORT}/payments_test
